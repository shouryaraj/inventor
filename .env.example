# Copy to .env (never commit it). Every variable is optional.

# LLM backend "anthropic-api" (default backend "claude-cli" needs no key; it uses your Claude Code login).
ANTHROPIC_API_KEY=

# GitHub issue search: 30 requests/min with a token, 10 without. If unset, `gh auth token` is tried.
GITHUB_TOKEN=

# OpenAlex: a free key raises the daily budget; an email identifies you politely.
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# Reddit (disabled unless set; needs an approved app, non-commercial use only).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Product Hunt (disabled unless set).
PRODUCTHUNT_TOKEN=

# Langfuse tracing + evals (needs `uv sync --extra observe`). Tracing is off unless both keys are set.
# Harvested excerpts and prompts are sent to this host: prefer a self-hosted instance.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
